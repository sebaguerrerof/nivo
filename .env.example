# Public URL and anonymous/publishable key from Supabase: Project Settings > API.
# These values are safe in the browser only because RLS is enabled.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only OpenAI configuration. Never prefix either value with VITE_.
# OPENAI_MODEL is optional; Nivo defaults to gpt-5.6-luna.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# Server-only. Required only for /api/delete-account to delete the authenticated
# user's own Supabase Auth account. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key