# URL and publishable anonymous key from Supabase: Project Settings > API.
# These values are safe to expose to the browser when RLS is enabled; never use
# a service-role key in a VITE_ variable or in this repository's frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
