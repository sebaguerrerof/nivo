# URL and publishable anonymous key from Supabase: Project Settings > API.
# These values are safe to expose to the browser when RLS is enabled; never use
# a service-role key in a VITE_ variable or in this repository's frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only configuration for api/plan-draft.ts. Never prefix either value with VITE_.
# OPENAI_MODEL is optional; Nivo defaults to gpt-5.6-luna for structured daily-plan drafts.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna